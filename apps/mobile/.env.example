# Copy to apps/mobile/.env (ignored by git). PUBLIC values only; never secrets.
# Both come from the Supabase dashboard, Project Settings > API (see docs/ACCOUNTS.md).
# Leave them empty (or delete .env) to run in guest-only mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: a deployed game server, e.g. wss://play.plamenite.app
EXPO_PUBLIC_SERVER_URL=
