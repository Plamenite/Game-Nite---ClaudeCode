# Loaded automatically when the server runs in development (npm run server).
# This file is committed: NO secrets here. Local-only secrets go in
# .env.development.local (ignored by git), see docs/ACCOUNTS.md.

# Still accept the app's development guest tokens (tests use them).
ALLOW_GUEST_TOKENS=true

# The Supabase project. The server verifies sign-in tokens against its
# public signing keys; no secret needed for that.
SUPABASE_URL=https://aimmofpruwznsidtxcyt.supabase.co

# Only for projects that still use the legacy shared JWT secret.
# Never commit a real value; put it in .env.development.local instead.
SUPABASE_JWT_SECRET=

# In .env.development.local (SECRET): SUPABASE_SERVICE_ROLE_KEY=...
# With it the coin ledger, profiles and friends live in Supabase;
# without it they live in this process's memory (fine for local play).

# Voice: the Agora App ID is public; the App Certificate is SECRET and goes
# in .env.development.local as AGORA_APP_CERTIFICATE=...
AGORA_APP_ID=ae5864ede5694931ac007396ed086143
