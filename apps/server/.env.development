# Loaded automatically when the server runs in development (npm run server).
# This file is committed: NO secrets here. Local-only secrets go in
# .env.development.local (ignored by git).

# Accept the app's temporary guest tokens until login exists.
ALLOW_GUEST_TOKENS=true

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# When set, the server verifies real sign-in tokens against it.
SUPABASE_URL=

# Only for legacy Supabase projects that still use a shared JWT secret.
# Never commit a real value; put it in .env.development.local instead.
SUPABASE_JWT_SECRET=
